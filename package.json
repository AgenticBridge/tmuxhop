{
  "name": "panehop",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "build": "npm run typecheck && npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "dev": "npm run build:client && tsx watch src/server/index.ts",
    "start": "npm run build:client && tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tmux",
    "terminal",
    "mobile",
    "xterm"
  ],
  "author": "",
  "license": "ISC",
  "description": "Mobile-friendly local tmux handoff prototype",
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
