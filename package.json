{
  "name": "tmuxhop",
  "version": "0.1.0",
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "build": "npm run typecheck && npm run build:client",
    "build:client": "vite build",
    "dev": "npm run build:client && tsx watch src/server/index.ts",
    "start": "npm run build:client && tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tmux",
    "terminal",
    "mobile",
    "xterm"
  ],
  "author": "",
  "license": "MIT",
  "description": "Mobile-friendly local tmux handoff prototype",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
